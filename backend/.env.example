# Backend Environment Variables — copy to .env and fill in values
# ─────────────────────────────────────────────────────────────────────────────
# DO NOT commit your real .env file. This is the example/template only.

PORT=4000
NODE_ENV=development

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Session Pooler (IPv4-compatible, use this for most networks):
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Direct Connection (IPv6 only — use for Render/cloud if pooler causes issues):
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Get both from: Supabase Dashboard → Settings → Database → Connection string
# Note: URL-encode special chars in password (e.g. @ → %40)
DATABASE_URL=

# ─── Auth — JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Leave empty to use email-only auth.
GOOGLE_CLIENT_ID=

# ─── Public URL Configuration ─────────────────────────────────────────────────
#
# API_PUBLIC_URL: Publicly reachable backend URL for media asset URLs.
# Set to your deployed/tunneled backend so phones can load uploaded images.
#
# Examples:
#   Render:  API_PUBLIC_URL=https://your-backend-name.onrender.com
#   ngrok:   API_PUBLIC_URL=https://xxxx-xx.ngrok-free.app  (changes every restart)
#
# After changing, run once to fix existing DB records:
#   curl -X POST https://YOUR_BACKEND/api/media/restamp-urls -H "Authorization: Bearer YOUR_JWT"
#
API_PUBLIC_URL=

# API_DEVICE_URL: LAN IP for same-network Expo Go dev (not needed if API_PUBLIC_URL is set)
API_DEVICE_URL=http://192.168.1.x:4000

# ─── SMTP / Email Verification ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The Expo/React Native dev URL. In production set to your deployed frontend URL.
CLIENT_APP_URL=http://localhost:8081
