# Backend Environment Variables — copy to .env and fill in values
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cognitive_support_app?schema=public"

# Auth — JWT
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0
# Leave empty for email-only auth.
GOOGLE_CLIENT_ID=""

# ─── Public URL Configuration ─────────────────────────────────────────────────
#
# API_PUBLIC_URL: Publicly reachable backend URL used for media asset URLs.
# Set this to your deployed/tunneled backend so phones can load uploaded images.
#
# Examples:
#   Railway:  API_PUBLIC_URL=https://cognitive-sanctuary-backend.up.railway.app
#   Render:   API_PUBLIC_URL=https://cognitive-sanctuary-backend.onrender.com
#   ngrok:    API_PUBLIC_URL=https://xxxx-xx.ngrok-free.app  (changes every restart)
#
# After changing this, run once to fix existing DB records:
#   curl -X POST https://YOUR_BACKEND/api/media/restamp-urls -H "Authorization: Bearer YOUR_JWT"
#
API_PUBLIC_URL=

# API_DEVICE_URL: LAN IP for same-network Expo Go dev (not needed if API_PUBLIC_URL is set)
API_DEVICE_URL=http://192.168.1.5:4000

# ─── SMTP / Email Verification ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# Logging
LOG_LEVEL="info"

# CORS — client app URL
CLIENT_APP_URL=http://localhost:8081
