# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/cognitive_support_app?schema=public"

# Auth — JWT
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# This MUST be the "Web application" OAuth 2.0 Client ID from Google Cloud Console:
# https://console.cloud.google.com → APIs & Services → Credentials
# This is used by the backend to verify Google ID tokens issued to your mobile app.
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"

# Logging
LOG_LEVEL="debug"

# CORS
CLIENT_APP_URL=http://localhost:8081
