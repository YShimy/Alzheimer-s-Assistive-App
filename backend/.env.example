# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/cognitive_support_app?schema=public"

# Auth — JWT
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# This MUST be the "Web application" OAuth 2.0 Client ID from Google Cloud Console:
# https://console.cloud.google.com → APIs & Services → Credentials
# Leave empty if only using email/password auth during development.
GOOGLE_CLIENT_ID=""

# ─── SMTP — Email Verification ────────────────────────────────────────────────
# For Gmail: enable 2FA then generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# Logging
LOG_LEVEL="debug"

# CORS
CLIENT_APP_URL=http://localhost:8081
