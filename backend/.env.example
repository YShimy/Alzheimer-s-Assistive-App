# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cognitive_support_app?schema=public"

# Auth
JWT_SECRET="change-me-to-a-random-secret-in-production"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Logging
LOG_LEVEL="debug"
