generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────

enum UserRole {
  PATIENT
  CAREGIVER
  ADMIN
}

enum CareLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum ReminderCategory {
  MEDICATION
  APPOINTMENT
  TASK
  HYDRATION
  MEAL
  CALL
  CUSTOM
  GENERAL
}

enum ReminderType {
  SIMPLE
  GUIDED
}

enum PriorityLevel {
  NORMAL
  HIGH
  CRITICAL
}

enum ChecklistCategory {
  MORNING
  EVENING
  HYGIENE
  MEALS
  MEDICATION
  EXERCISE
  ACTIVITY
  HOUSEHOLD
  APPOINTMENTS
  SOCIAL
  CUSTOM
  GENERAL
}

enum ReminderEventType {
  // Lifecycle
  CREATED
  EDITED
  FIRED
  DISMISSED
  DEACTIVATED
  REACTIVATED
  
  // Simple reminder actions
  DONE
  SNOOZED
  SKIPPED
  
  // Guided reminder actions
  START_NOW
  GUIDED_REMINDER_STARTED
  LINKED_CHECKLIST_OPENED
  LINKED_CHECKLIST_COMPLETED
  LINKED_CHECKLIST_ABANDONED
  
  // Escalation
  ESCALATION_TRIGGERED
  HIGH_PRIORITY_SKIPPED
  CRITICAL_SKIPPED
  REPEATED_SKIP_DETECTED
}

enum ChecklistRunStatus {
  STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum VerificationPurpose {
  SIGNUP
  PASSWORD_RESET
}

// ─── Models ───────────────────────────────────────────

model User {
  id                        String    @id @default(uuid())
  googleId                  String?   @unique
  email                     String    @unique
  passwordHash              String?
  displayName               String
  age                       Int?
  role                      UserRole  @default(PATIENT)
  language                  String    @default("en") // "ar" | "en"
  timezone                  String    @default("UTC")
  isActive                  Boolean   @default(true)
  emailVerifiedAt           DateTime?
  accessibilitySettings     Json      @default("{\"textSize\": \"medium\", \"highContrast\": false, \"audioCuesEnabled\": false}")
  preferredNotificationMode String    @default("push") // push | local | silent
  pushToken                 String? // Expo push notification token
  lastSeenAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Relations
  caregiverLinks     CareLink[]          @relation("CaregiverLinks")
  patientLinks       CareLink[]          @relation("PatientLinks")
  invitedCareLinks   CareLink[]          @relation("InvitedByUser")
  patientReminders   Reminder[]          @relation("PatientReminders")
  createdReminders   Reminder[]          @relation("CreatedReminders")
  editedReminders    Reminder[]          @relation("EditedReminders")
  reminderEvents     ReminderEvent[]     @relation("PatientReminderEvents")
  actorEvents        ReminderEvent[]     @relation("ActorReminderEvents")
  checklistTemplates ChecklistTemplate[] @relation("PatientTemplates")
  createdTemplates   ChecklistTemplate[] @relation("CreatedTemplates")
  editedTemplates    ChecklistTemplate[] @relation("EditedTemplates")
  checklistRuns      ChecklistRun[]      @relation("PatientRuns")
  actorRuns          ChecklistRun[]      @relation("ActorRuns")
  gameSessions       GameSession[]       @relation("PatientGames")
  actorGameSessions  GameSession[]       @relation("ActorGames")
  analyticsEvents    AnalyticsEvent[]    @relation("PatientAnalytics")
  actorAnalytics     AnalyticsEvent[]    @relation("ActorAnalytics")

  contactConsents    ContactSupportConsent[] @relation("PatientConsents")
  patientContacts    PatientContact[]        @relation("PatientContacts")
  createdMemos       ContactMemo[]           @relation("CreatedMemos")
  uploadedAssets     MediaAsset[]            @relation("UploadedAssets")
  ownedAssets        MediaAsset[]            @relation("OwnedAssets")
  patientDocuments         PatientDocument[] @relation("PatientDocuments")
  uploadedPatientDocuments PatientDocument[] @relation("UploadedPatientDocuments")

  // Important Information Card
  importantInfo            PatientImportantInfo?  @relation("PatientImportantInfo")
  updatedImportantInfoCards PatientImportantInfo[] @relation("UpdatedImportantInfo")

  // Summary Exports
  patientSummaryExports    PatientSummaryExport[] @relation("PatientSummaryExports")
  generatedSummaryExports  PatientSummaryExport[] @relation("GeneratedSummaryExports")

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@map("users")
}

enum PatientDocumentCategory {
  PRESCRIPTION
  LAB_RESULT
  SCAN_IMAGING
  DOCTOR_VISIT_NOTE
  DISCHARGE_SUMMARY
  MEDICATION_PLAN
  CARE_PLAN
  ADMINISTRATIVE
  OTHER
}

enum PatientDocumentStatus {
  ACTIVE
  ARCHIVED
}

model PatientDocument {
  id               String   @id @default(uuid())

  patientId        String
  uploadedByUserId String

  title            String
  category         PatientDocumentCategory
  documentDate     DateTime?
  sourceName       String?
  notes            String?

  originalFileName String
  mimeType         String
  fileSizeBytes    Int

  storageProvider  String   @default("supabase")
  storageBucket    String
  storageKey       String

  status           PatientDocumentStatus @default(ACTIVE)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  archivedAt       DateTime?

  patient          User     @relation("PatientDocuments", fields: [patientId], references: [id])
  uploadedBy       User     @relation("UploadedPatientDocuments", fields: [uploadedByUserId], references: [id])

  @@index([patientId])
  @@index([uploadedByUserId])
  @@index([category])
  @@index([documentDate])
  @@index([status])
  @@map("patient_documents")
}

model EmailVerification {
  id         String              @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  maxAttempts Int                @default(5)
  lastSentAt DateTime            @default(now())
  purpose    VerificationPurpose @default(SIGNUP)
  metadata   Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([email])
  @@index([email, purpose])
  @@index([expiresAt])
  @@map("email_verifications")
}

model CareLink {
  id              String         @id @default(uuid())
  caregiverUserId String
  patientUserId   String?
  inviteCode      String         @unique
  status          CareLinkStatus @default(PENDING)
  permissions     Json           @default("{\"canCreateReminders\": true, \"canEditReminders\": true, \"canViewProgress\": true, \"canCreateChecklists\": true, \"canEditChecklists\": true, \"canMarkTasksOnBehalf\": false}")
  invitedByUserId String
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  caregiver User  @relation("CaregiverLinks", fields: [caregiverUserId], references: [id])
  patient   User? @relation("PatientLinks", fields: [patientUserId], references: [id])
  invitedBy User  @relation("InvitedByUser", fields: [invitedByUserId], references: [id])

  @@index([caregiverUserId])
  @@index([patientUserId])
  @@index([inviteCode])
  @@index([status])
  @@map("care_links")
}

model Reminder {
  id                          String           @id @default(uuid())
  patientUserId               String
  title                       String
  category                    ReminderCategory @default(TASK)
  scheduledTime               String           // HH:mm format
  repeatRule                  Json?            // { type: "daily" | "weekly" | "custom", interval?: number }
  startDate                   DateTime
  endDate                     DateTime?
  daysOfWeek                  Int[]            @default([]) // 0=Sun..6=Sat
  description                 String?
  
  // Redesigned: proper priority enum instead of numeric
  priority                    PriorityLevel    @default(NORMAL)
  
  // Redesigned: reminder type (simple vs guided)
  reminderType                ReminderType     @default(SIMPLE)
  
  // Redesigned: optional visual cue for reminder
  visualCueAssetId            String?
  
  linkedChecklistTemplateId   String?
  snoozeEnabled               Boolean          @default(true)
  defaultSnoozeMinutes        Int              @default(10)
  isActive                    Boolean          @default(true)
  archivedAt                  DateTime?
  createdByUserId             String
  lastEditedByUserId          String
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  patient          User              @relation("PatientReminders", fields: [patientUserId], references: [id])
  createdBy        User              @relation("CreatedReminders", fields: [createdByUserId], references: [id])
  lastEditedBy     User              @relation("EditedReminders", fields: [lastEditedByUserId], references: [id])
  linkedChecklist  ChecklistTemplate? @relation(fields: [linkedChecklistTemplateId], references: [id])
  visualCueAsset   MediaAsset?       @relation("ReminderVisualCue", fields: [visualCueAssetId], references: [id])
  events           ReminderEvent[]

  @@index([patientUserId])
  @@index([patientUserId, isActive])
  @@index([category])
  @@index([createdByUserId])
  @@index([priority])
  @@index([reminderType])
  @@map("reminders")
}

model ReminderEvent {
  id                 String            @id @default(uuid())
  reminderId         String
  patientUserId      String
  eventType          ReminderEventType
  scheduledFor       DateTime?
  timestamp          DateTime          @default(now())
  actorUserId        String
  actorRole          String            // "patient" | "caregiver" | "system"
  source             String            @default("system_scheduler") // notification | home | reminder_list | caregiver_panel | system_scheduler
  actionValue        Json?             // e.g. { snoozeDurationMinutes: 10, checklistRunId: "..." }
  optionalReasonCode String?           // e.g. "escalation_skip_count", "high_priority"
  
  // Redesigned: link to related checklist run for guided reminders
  linkedChecklistRunId String?
  
  // Redesigned: escalation tracking
  escalationTriggered Boolean         @default(false)
  escalationReason    String?
  
  createdAt          DateTime          @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id])
  patient  User     @relation("PatientReminderEvents", fields: [patientUserId], references: [id])
  actor    User     @relation("ActorReminderEvents", fields: [actorUserId], references: [id])

  @@index([reminderId])
  @@index([patientUserId])
  @@index([eventType])
  @@index([timestamp])
  @@index([escalationTriggered])
  @@map("reminder_events")
}

model ChecklistTemplate {
  id                     String   @id @default(uuid())
  patientUserId          String
  title                  String
  description            String?
  category               ChecklistCategory @default(GENERAL)
  steps                  Json     // [{ stepId, label, order, optionalHint }]
  estimatedDurationMinutes Int?
  isActive               Boolean  @default(true)
  archivedAt             DateTime?
  createdByUserId        String
  lastEditedByUserId     String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  patient    User           @relation("PatientTemplates", fields: [patientUserId], references: [id])
  createdBy  User           @relation("CreatedTemplates", fields: [createdByUserId], references: [id])
  editedBy   User           @relation("EditedTemplates", fields: [lastEditedByUserId], references: [id])
  runs       ChecklistRun[]
  reminders  Reminder[]

  @@index([patientUserId])
  @@index([isActive])
  @@map("checklist_templates")
}

model ChecklistRun {
  id                    String             @id @default(uuid())
  checklistTemplateId   String
  patientUserId         String
  status                ChecklistRunStatus @default(STARTED)
  startedAt             DateTime?
  completedAt           DateTime?
  abandonedAt           DateTime?
  completedStepsCount   Int                @default(0)
  totalStepsCount       Int                @default(0)
  lastStepIndexReached  Int                @default(0)
  stepResults           Json               @default("[]") // [{ stepId, completed, timestamp }]
  durationSeconds       Int?
  actorUserId           String
  actorRole             String             // "patient" | "caregiver"
  startedFrom           String             @default("home") // home | reminder | caregiver_panel
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  template ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])
  patient  User              @relation("PatientRuns", fields: [patientUserId], references: [id])
  actor    User              @relation("ActorRuns", fields: [actorUserId], references: [id])

  @@index([checklistTemplateId])
  @@index([patientUserId])
  @@index([status])
  @@map("checklist_runs")
}

model GameSession {
  id                String   @id @default(uuid())
  patientUserId     String
  gameType          String
  difficultyLevel   String   @default("easy")
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  durationSeconds   Int?
  score             Int?
  highestTierReached Int?
  levelsPlayed      Int      @default(0)
  levelsSucceeded   Int      @default(0)
  levelsFailed      Int      @default(0)
  completed         Boolean  @default(false)
  quitEarly         Boolean  @default(false)
  actorUserId       String
  actorRole         String   // "patient" | "caregiver"
  source            String   @default("home")
  metadata          Json?    // optional structured details
  createdAt         DateTime @default(now())

  patient    User              @relation("PatientGames", fields: [patientUserId], references: [id])
  actor      User              @relation("ActorGames", fields: [actorUserId], references: [id])
  levelResults GameLevelResult[]

  @@index([patientUserId])
  @@index([gameType])
  @@index([startedAt])
  @@map("game_sessions")
}

model GameLevelResult {
  id                String   @id @default(uuid())
  sessionId         String
  levelIndex        Int
  difficultyTier    Int
  gridRows          Int
  gridCols          Int
  bombCount         Int
  previewDurationMs Int
  solveTimeMs       Int?
  success           Boolean
  scoreDelta        Int      @default(0)
  pathLength        Int      @default(0)
  retryCount        Int      @default(0)
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  metadata          Json?
  createdAt         DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([difficultyTier])
  @@map("game_level_results")
}

model AnalyticsEvent {
  id            String   @id @default(uuid())
  eventName     String
  occurredAt    DateTime @default(now())
  patientUserId String?
  actorUserId   String?
  actorRole     String?
  sessionId     String?
  screenName    String?
  source        String?
  appVersion    String?
  platform      String?
  language      String?
  payload       Json?
  createdAt     DateTime @default(now())

  patient User? @relation("PatientAnalytics", fields: [patientUserId], references: [id])
  actor   User? @relation("ActorAnalytics", fields: [actorUserId], references: [id])

  @@index([eventName])
  @@index([patientUserId])
  @@index([occurredAt])
  @@map("analytics_events")
}

// ─── Contacts & Media ──────────────────────────────────

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

enum ContactSourceType {
  DEVICE_CONTACTS
  MANUAL
}

enum AssetType {
  IMAGE
  VIDEO
}

model ContactSupportConsent {
  id            String        @id @default(uuid())
  patientUserId String        @unique
  status        ConsentStatus @default(PENDING)
  grantedAt     DateTime?
  revokedAt     DateTime?
  source        String?       // "device_prompt", "settings"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient User @relation("PatientConsents", fields: [patientUserId], references: [id])

  @@map("contact_support_consents")
}

model PatientContact {
  id              String            @id @default(uuid())
  patientUserId   String
  sourceType      ContactSourceType @default(DEVICE_CONTACTS)
  sourceContactId String?
  displayName     String
  normalizedPhones Json?
  normalizedEmails Json?
  importedAt      DateTime          @default(now())
  lastSyncedAt    DateTime?
  isArchived      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient User          @relation("PatientContacts", fields: [patientUserId], references: [id])
  memos   ContactMemo[]

  @@index([patientUserId])
  @@index([sourceContactId])
  @@map("patient_contacts")
}

model ContactMemo {
  id                    String   @id @default(uuid())
  patientContactId      String
  patientUserId         String
  createdByUserId       String
  relationLabel         String?
  shortMemo             String?
  photoAssetId          String?
  isArchived            Boolean  @default(false)
  
  patientFavorite       Boolean  @default(false)
  caregiverFavorite     Boolean  @default(false)
  patientPriorityRank   Int?
  caregiverPriorityRank Int?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contact      PatientContact @relation(fields: [patientContactId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("CreatedMemos", fields: [createdByUserId], references: [id])
  photoAsset   MediaAsset?    @relation(fields: [photoAssetId], references: [id])

  @@index([patientContactId])
  @@index([patientUserId])
  @@map("contact_memos")
}

model MediaAsset {
  id               String    @id @default(uuid())
  ownerUserId      String?
  uploadedByUserId String
  assetType        AssetType @default(IMAGE)
  storageProvider  String    @default("local")
  storageKey       String
  publicUrl        String?
  mimeType         String?
  width            Int?
  height           Int?
  durationSeconds  Int?
  thumbnailUrl     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner      User? @relation("OwnedAssets", fields: [ownerUserId], references: [id])
  uploadedBy User  @relation("UploadedAssets", fields: [uploadedByUserId], references: [id])
  memos      ContactMemo[]
  reminders  Reminder[]    @relation("ReminderVisualCue")

  @@index([ownerUserId])
  @@map("media_assets")
}

// ─── Important Information Card ────────────────────────────────

model PatientImportantInfo {
  id                       String    @id @default(uuid())

  patientId                String    @unique
  updatedByUserId          String?

  // Basic Support Info
  preferredName            String?
  dateOfBirth              DateTime?
  primaryLanguage          String?
  addressNote              String?
  livingSituation          String?

  // Emergency / Support Contacts
  primaryCaregiverName     String?
  primaryCaregiverPhone    String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  doctorName               String?
  doctorPhone              String?
  clinicOrHospitalName     String?

  // Health Reference Info (caregiver-entered, not verified)
  allergies                String?
  currentMedicationSummary String?
  importantConditionsNote  String?
  mobilitySupportNote      String?
  dietaryNotes             String?

  // Daily Routine Support
  morningRoutineNotes      String?
  eveningRoutineNotes      String?
  mealSupportNotes         String?
  sleepRoutineNotes        String?
  hydrationNotes           String?

  // Communication and Comfort
  communicationTips        String?
  calmingStrategies        String?
  memorySupportTips        String?
  preferredActivities      String?
  distressTriggers         String?

  // Safety Notes
  homeSafetyNotes          String?
  wanderingRiskNotes       String?
  emergencyInstructions    String?

  // Additional Notes
  generalNotes             String?

  // Visibility config: { fieldName: "PATIENT_VISIBLE" | "CAREGIVER_ONLY" }
  visibilityConfig         Json?
  lastReviewedAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  patient   User  @relation("PatientImportantInfo", fields: [patientId], references: [id])
  updatedBy User? @relation("UpdatedImportantInfo", fields: [updatedByUserId], references: [id])

  @@index([updatedByUserId])
  @@index([updatedAt])
  @@map("patient_important_info")
}

// ─── Summary Exports ───────────────────────────────────────────

enum PatientSummaryExportStatus {
  COMPLETED
  ARCHIVED
  FAILED
}

model PatientSummaryExport {
  id                  String                    @id @default(uuid())

  patientId           String
  generatedByUserId   String

  rangeStart          DateTime
  rangeEnd            DateTime

  title               String?
  status              PatientSummaryExportStatus @default(COMPLETED)

  storageProvider     String   @default("supabase")
  storageBucket       String
  storageKey          String
  fileSizeBytes       Int?
  mimeType            String   @default("application/pdf")

  includedSections    Json?
  summaryMetadata     Json?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  archivedAt          DateTime?

  patient     User @relation("PatientSummaryExports", fields: [patientId], references: [id])
  generatedBy User @relation("GeneratedSummaryExports", fields: [generatedByUserId], references: [id])

  @@index([patientId])
  @@index([generatedByUserId])
  @@index([rangeStart, rangeEnd])
  @@index([createdAt])
  @@map("patient_summary_exports")
}
