# Mobile Environment Variables — copy to .env and fill in values
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL — the ONLY variable controlling which backend the app uses.
#
# REQUIRED for web builds (production):
# EXPO_PUBLIC_API_URL=https://your-backend.vercel.app/api
#
# Local dev (same-network Expo Go): use your LAN/hotspot IP
# EXPO_PUBLIC_API_URL=http://192.168.1.5:4000/api
#
# Quick remote demo via tunnel (expo start --tunnel):
# EXPO_PUBLIC_API_URL=https://xxxx-xx.ngrok-free.app/api
EXPO_PUBLIC_API_URL=https://your-backend.vercel.app/api

# ─── Google OAuth 2.0 Client IDs ─────────────────────────────────────────────
# Leave empty to use email/password auth only during development.

# Web OAuth 2.0 Client ID — must match GOOGLE_CLIENT_ID on backend
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS OAuth 2.0 Client ID — required for Google Sign-In on iOS builds
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
