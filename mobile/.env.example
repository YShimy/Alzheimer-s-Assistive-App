# Mobile Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Backend API base URL — use your machine's LAN IP, not localhost,
# when testing on a physical device or Android emulator.
EXPO_PUBLIC_API_URL=http://192.168.1.5:4000/api

# ─── Google OAuth 2.0 Client IDs ─────────────────────────────────────────────
# Get these from Google Cloud Console:
# https://console.cloud.google.com → APIs & Services → Credentials
# Leave empty if only using email/password auth during development.

# Web OAuth 2.0 Client ID — REQUIRED for Google Sign-In.
# Must match GOOGLE_CLIENT_ID on the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS OAuth 2.0 Client ID — Required for iOS builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
